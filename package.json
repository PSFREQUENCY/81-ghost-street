    "@tanstack/react-query": "^5.59.20",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-stdlib": "^2.33.0",
    "viem": "^2.21.44",
    "wagmi": "^2.13.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
